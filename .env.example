# Proveedor Meta Muse Spark (documentación: https://dev.meta.ai/docs/quickstart)
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
MODEL_API_KEY=
# Protocolo: responses (recomendado) | chat
META_PROTOCOL=responses
# Demo: synthetic (default) | real (requiere JSON explícito, ver ADAPTER)
IA_DEMO_MODE=synthetic

# Proveedor Baseten Model API (docs: https://docs.baseten.co/quickstart)
# Solo Chat Completions; modelo exacto del hackathon:
# meta-models/muse-spark-open-1026
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026
BASETEN_API_KEY=
# Timeout segundos (sin reintentos automaticos)
BASETEN_TIMEOUT=60
