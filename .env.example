# Proveedor Meta Muse Spark (documentación: https://dev.meta.ai/docs/quickstart)
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
MODEL_API_KEY=
# Protocolo: responses (recomendado) | chat
META_PROTOCOL=responses
# Demo: synthetic (default) | real (requiere JSON explícito, ver ADAPTER)
IA_DEMO_MODE=synthetic
