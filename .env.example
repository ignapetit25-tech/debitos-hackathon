# Meta Muse Spark provider (docs: https://dev.meta.ai/docs/quickstart)
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
MODEL_API_KEY=
# Protocol: responses (recommended) | chat
META_PROTOCOL=responses
# Demo: synthetic (default) | real (needs explicit JSON, see ADAPTER)
IA_DEMO_MODE=synthetic

# Baseten Model API provider (docs: https://docs.baseten.co/quickstart)
# Chat Completions only; exact hackathon model:
# meta-models/muse-spark-open-1026
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026
BASETEN_API_KEY=
# Timeout in seconds (no automatic retries)
BASETEN_TIMEOUT=60
